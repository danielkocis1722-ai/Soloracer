{
  "expo": {
    "name": "Soloracer",
    "slug": "soloracer",
    "scheme": "soloracer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Soloracer to use your location while you record or drive a trail."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielkocis.soloracer"
    },
    "android": {
      "package": "com.danielkocis.soloracer",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3361ec16-0f6d-4cfb-88ba-b7e63e047b44"
      }
    }
  }
}
